# ─────────────────────────────────────────────────────────────
# Fashion Stylist AI — environment variables
# Copy to `.env` and fill in. All values are optional for a
# static-only run; the API degrades gracefully when unset.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# MySQL database (Drizzle ORM). Without it, data features are inert
# but the app still serves the landing and public routes.
DATABASE_URL=mysql://user:password@localhost:3306/fashion_stylist

# OAuth / session (Manus-style OpenID Connect)
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
JWT_SECRET=replace-with-a-long-random-string

# LLM + storage (OpenAI-compatible chat completions + S3 presign)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
